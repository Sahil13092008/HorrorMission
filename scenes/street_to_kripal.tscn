[node name="BriefText" type="Label" parent="StreetUI/NextChapterCard/Margin/VBox/BriefBox/BriefMargin/BriefVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.92, 0.92, 1)
theme_override_font_sizes/font_size = 16
text = "कृपाल की माँ ने रोते हुए पुराने तांत्रिक के श्राप का सच बताया और तांत्रिक से बचाव के लिए रक्षा-कवच और भानगढ़ का गुप्त नक्शा टीम को सौंप दिया।
साहिल, आशुतोष और तुम अब पूरी तैयारी और हथियारों के साथ सीधे भानगढ़ किले की ओर कूच कर रहे हो!
क्या तुम अपने भाई कृपाल को उस खौफनाक शैतान के चंगुल से ज़िंदा निकाल पाओगे?!"
