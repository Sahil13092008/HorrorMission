[node name="StatusDesc" type="Label" parent="CutsceneUI/SignalLostCard/Margin/VBox/CardBox/CardMargin/CardVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.92, 0.92, 1)
theme_override_font_sizes/font_size = 16
text = "कृपाल की चीख के साथ उसका थर्मल कैमरा और बॉडीकैम पूरी तरह नष्ट हो गए हैं।
साहिल और आशुतोष हथियारों और ट्रैप्स के साथ भानगढ़ के मुख्य दिल्ली गेट पर पहुँच रहे हैं!
क्या वे कृपाल को उस तांत्रिक के श्राप से ज़िंदा बचा पाएंगे?!"
autowrap_mode = 2

